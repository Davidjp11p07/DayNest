<%@ page pageEncoding="UTF-8" %>
<%@ include file="imagenes.jspf" %>
<c:choose><c:when test="${empty inmuebles}"><div class="empty"><svg class="icon" aria-hidden="true"><use href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/iconos.svg#search"/></svg><h3>Tu próximo espacio aún está por descubrir</h3><p>No encontramos inmuebles con estos filtros. Puedes modificar o quitar los filtros de tipo, entorno, ciudad, fechas o presupuesto.</p><a class="button secondary" href="${fn:escapeXml(pageContext.request.contextPath)}/buscar">Ver todos los alojamientos</a></div></c:when><c:otherwise>
<div class="grid"><c:forEach var="i" items="${inmuebles}" end="${empty limiteTarjetas ? fn:length(inmuebles) : limiteTarjetas}"><article class="card property-card">
<c:url var="detalleUrl" value="/inmueble"><c:param name="id" value="${i.id}"/><c:param name="entrada" value="${param.entrada}"/><c:param name="salida" value="${param.salida}"/><c:param name="huespedes" value="${empty param.huespedes ? param.capacidad : param.huespedes}"/></c:url>
<a class="card-photo" href="${fn:escapeXml(detalleUrl)}" aria-label="Ver ${fn:escapeXml(i.titulo)}"><img src="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/${fn:escapeXml(fotosDayNest[(i.id - 1) % fn:length(fotosDayNest)])}" alt="Foto ilustrativa para ${fn:escapeXml(i.titulo)}" width="800" height="600" loading="lazy"><span class="photo-label">Foto de referencia</span></a>
<div class="card-body"><span class="city"><svg class="icon" aria-hidden="true"><use href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/iconos.svg#pin"/></svg><c:out value="${i.ciudad}"/></span>
<h3><a href="${fn:escapeXml(detalleUrl)}"><c:out value="${i.titulo}"/></a></h3>
<p class="muted capacity"><svg class="icon" aria-hidden="true"><use href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/iconos.svg#users"/></svg>Hasta <c:out value="${i.capacidad}"/> huéspedes</p>
<div class="card-bottom"><p class="price"><fmt:formatNumber value="${i.precioPorNoche}" pattern="#,##0.00"/><span class="price-currency"> <c:out value="${i.moneda}"/></span><br><small>por noche</small></p><a class="card-link" href="${fn:escapeXml(detalleUrl)}" aria-label="Ver inmueble ${fn:escapeXml(i.titulo)}"><svg class="icon" aria-hidden="true"><use href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/iconos.svg#arrow"/></svg></a></div></div></article></c:forEach></div>
</c:otherwise></c:choose>
<c:set var="paginacion" value="${empty limiteTarjetas ? navInmuebles : null}"/><%@ include file="paginador.jspf" %>
