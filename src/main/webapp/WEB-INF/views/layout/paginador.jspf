<%@ page pageEncoding="UTF-8" %>
<c:if test="${not empty paginacion and paginacion.total gt 0}">
<nav class="pagination" aria-label="Paginación del listado">
    <p class="muted">Mostrando <c:out value="${paginacion.desde}"/>–<c:out value="${paginacion.hasta}"/> de <c:out value="${paginacion.total}"/> resultados.</p>
    <div class="actions">
        <c:if test="${not empty paginacion.anterior}"><a class="button secondary" href="${fn:escapeXml(paginacion.anterior)}">Anterior</a></c:if>
        <span>Página <c:out value="${paginacion.numero}"/> de <c:out value="${paginacion.paginas}"/></span>
        <c:if test="${not empty paginacion.siguiente}"><a class="button secondary" href="${fn:escapeXml(paginacion.siguiente)}">Siguiente</a></c:if>
    </div>
</nav>
</c:if>
