<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${empty giros}"><p class="empty">No hay giros para mostrar.</p></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Giro / reserva</th><th>Propietario</th><th>Total / moneda</th><th>Comisión</th><th>Neto / moneda</th><th>Estado / referencia / fecha</th></tr></thead><tbody><c:forEach var="g" items="${giros}"><tr><td>#<c:out value="${g.id}"/> / #<c:out value="${g.reserva.id}"/></td><td><c:out value="${g.propietario.nombre}"/></td><td><fmt:formatNumber value="${g.reserva.total}" pattern="#,##0.00"/> <c:out value="${g.moneda}"/></td><td><fmt:formatNumber value="${g.porcentajeComision}" type="percent" maxFractionDigits="2"/><br><fmt:formatNumber value="${g.montoComision}" pattern="#,##0.00"/> <c:out value="${g.moneda}"/></td><td><fmt:formatNumber value="${g.monto}" pattern="#,##0.00"/> <c:out value="${g.moneda}"/></td><td><c:out value="${g.estado}"/><br><c:out value="${g.referencia}"/><br><c:out value="${g.fecha}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
<c:set var="paginacion" value="${navGiros}"/><%@ include file="paginador.jspf" %>
