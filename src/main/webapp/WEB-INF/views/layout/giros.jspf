<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${empty giros}"><p class="empty"><c:out value="${textos['ui197']}"/></p></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th><c:out value="${textos['ui198']}"/></th><th><c:out value="${textos['ui036']}"/></th><th><c:out value="${textos['ui199']}"/></th><th><c:out value="${textos['ui200']}"/></th><th><c:out value="${textos['ui201']}"/></th><th><c:out value="${textos['ui202']}"/></th><th><c:out value="${textos['ui203']}"/></th></tr></thead><tbody><c:forEach var="g" items="${giros}"><tr><td>#<c:out value="${g.id}"/> / #<c:out value="${g.reserva.id}"/></td><td><c:out value="${g.propietario.nombre}"/></td><td><fmt:formatNumber value="${g.reserva.total}" pattern="#,##0.00"/> <c:out value="${g.moneda}"/></td><td><fmt:formatNumber value="${g.porcentajeComision}" type="percent" maxFractionDigits="2"/><br><fmt:formatNumber value="${g.montoComision}" pattern="#,##0.00"/> <c:out value="${g.moneda}"/></td><td><fmt:formatNumber value="${g.monto}" pattern="#,##0.00"/> <c:out value="${g.moneda}"/></td><td><c:out value="${g.cuentaDestino}"/><br><c:out value="${g.origenAutorizacion}"/></td><td><c:out value="${empty textos[g.estado.toString()] ? g.estado : textos[g.estado.toString()]}"/><br><c:out value="${g.referencia}"/><br><c:out value="${g.fecha}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
<c:set var="paginacion" value="${navGiros}"/><%@ include file="paginador.jspf" %>
