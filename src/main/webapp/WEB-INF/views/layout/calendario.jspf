<%@ page pageEncoding="UTF-8" %>
<section class="availability-calendar" data-calendar aria-label="${fn:escapeXml(textos['ui180'])}">
<c:url var="mesAnterior" value="${rutaCalendario}"><c:param name="id" value="${inmueble.id}"/><c:param name="mes" value="${calendario.anterior}"/><c:param name="entrada" value="${form.entrada}"/><c:param name="salida" value="${form.salida}"/><c:param name="huespedes" value="${form.huespedes}"/></c:url>
<c:url var="mesSiguiente" value="${rutaCalendario}"><c:param name="id" value="${inmueble.id}"/><c:param name="mes" value="${calendario.siguiente}"/><c:param name="entrada" value="${form.entrada}"/><c:param name="salida" value="${form.salida}"/><c:param name="huespedes" value="${form.huespedes}"/></c:url>
<div class="calendar-heading"><a class="calendar-nav" data-calendar-nav href="${fn:escapeXml(mesAnterior)}" aria-label="${fn:escapeXml(textos['ui181'])}">&#8592;</a><h3><c:out value="${idioma eq 'en' ? calendario.tituloIngles : calendario.titulo}"/></h3><a class="calendar-nav" data-calendar-nav href="${fn:escapeXml(mesSiguiente)}" aria-label="${fn:escapeXml(textos['ui182'])}">&#8594;</a></div>
<div class="calendar-weekdays" aria-hidden="true"><c:forTokens var="semana" items="${textos['weekdays']}" delims=","><span><c:out value="${semana}"/></span></c:forTokens></div>
<div class="calendar-days"><c:forEach var="dia" items="${calendario.dias}"><c:choose><c:when test="${empty dia.fecha}"><span class="calendar-blank" aria-hidden="true"></span></c:when><c:otherwise><button type="button" class="calendar-day" data-calendar-date="${dia.fecha}" data-estado="${dia.estado}" aria-label="${fn:escapeXml(idioma eq 'en' ? dia.etiquetaIngles : dia.etiqueta)}" title="${fn:escapeXml(idioma eq 'en' ? dia.etiquetaIngles : dia.etiqueta)}" ${dia.hoy ? 'aria-current="date"' : ''} ${dia.estado eq 'PASADO' ? 'disabled' : ''}><span><c:out value="${dia.numero}"/></span><span class="calendar-day-state"><c:choose><c:when test="${dia.estado eq 'RESERVADO'}"><c:out value="${textos['ui183']}"/></c:when><c:when test="${dia.estado eq 'BLOQUEADO'}"><c:out value="${textos['ui184']}"/></c:when></c:choose></span></button></c:otherwise></c:choose></c:forEach></div>
<div class="calendar-legend" aria-label="${fn:escapeXml(textos['ui185'])}"><span class="legend-free"><c:out value="${textos['ui186']}"/></span><span class="legend-reserved"><c:out value="${textos['ui183']}"/></span><span class="legend-blocked"><c:out value="${textos['ui184']}"/></span></div>
<p class="calendar-status muted" data-calendar-status role="status"><c:out value="${textos['ui187']}"/></p>
<div hidden><c:forEach var="rango" items="${calendario.rangos}"><span data-calendar-range data-inicio="${rango.inicio}" data-fin="${rango.fin}"></span></c:forEach></div>
<noscript><p class="muted"><c:out value="${textos['ui188']}"/></p></noscript>
</section>
