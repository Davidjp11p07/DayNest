<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${empty pagos}"><p class="empty"><c:out value="${textos['ui258']}"/></p></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th><c:out value="${textos['ui259']}"/></th><th><c:out value="${textos['ui026']}"/></th><th><c:out value="${textos['ui260']}"/></th><th><c:out value="${textos['ui261']}"/></th><th><c:out value="${textos['ui262']}"/></th><th><c:out value="${textos['ui263']}"/></th><th><c:out value="${textos['ui264']}"/></th><th><c:out value="${textos['ui265']}"/></th></tr></thead><tbody><c:forEach var="p" items="${pagos}"><tr><td>#<c:out value="${p.id}"/> / #<c:out value="${p.reserva.id}"/></td><td><c:out value="${p.reserva.inmueble.titulo}"/></td><td><fmt:formatNumber value="${p.monto}" pattern="#,##0.00"/> <c:out value="${p.moneda}"/></td><td><c:out value="${empty textos[p.clase.toString()] ? p.clase : textos[p.clase.toString()]}"/></td><td><c:out value="${p.metodoRegistrado}"/><c:if test="${not empty p.bancoPago}"><br><c:out value="${p.bancoPago}"/> · <c:out value="${p.tipoCuentaPago}"/> · <c:out value="${p.numeroCuentaPago}"/><br><c:out value="${p.usoCuenta}"/></c:if></td><td><c:out value="${p.referencia}"/></td><td><c:out value="${p.fecha}"/></td><td><c:choose><c:when test="${p.estado eq 'APROBADO'}"><c:out value="${textos['ui266']}"/></c:when><c:when test="${p.estado eq 'RECHAZADO'}"><c:out value="${textos['ui267']}"/></c:when><c:otherwise><c:out value="${textos['ui268']}"/></c:otherwise></c:choose> / <c:out value="${empty textos[p.reserva.estado.toString()] ? p.reserva.estado : textos[p.reserva.estado.toString()]}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
<c:set var="paginacion" value="${navPagos}"/><%@ include file="paginador.jspf" %>
