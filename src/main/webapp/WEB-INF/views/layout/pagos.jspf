<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${empty pagos}"><p class="empty">No hay pagos para mostrar.</p></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Pago / reserva</th><th>Inmueble</th><th>Importe / moneda</th><th>Clase</th><th>Referencia</th><th>Fecha</th><th>Estado pago / reserva</th></tr></thead><tbody><c:forEach var="p" items="${pagos}"><tr><td>#<c:out value="${p.id}"/> / #<c:out value="${p.reserva.id}"/></td><td><c:out value="${p.reserva.inmueble.titulo}"/></td><td><fmt:formatNumber value="${p.monto}" pattern="#,##0.00"/> <c:out value="${p.moneda}"/></td><td><c:out value="${p.clase}"/></td><td><c:out value="${p.referencia}"/></td><td><c:out value="${p.fecha}"/></td><td><c:out value="${p.estado}"/> / <c:out value="${p.reserva.estado}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
<c:set var="paginacion" value="${navPagos}"/><%@ include file="paginador.jspf" %>
