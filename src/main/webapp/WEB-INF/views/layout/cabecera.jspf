<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="es_CO"/>
<!doctype html><html lang="es"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>DayNest · Tu espacio, tus días.</title>
<link rel="icon" type="image/svg+xml" href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/daynest-logo.svg">
<link rel="stylesheet" href="${fn:escapeXml(pageContext.request.contextPath)}/assets/styles.css">
<link rel="stylesheet" href="${fn:escapeXml(pageContext.request.contextPath)}/assets/daynest.css">
<script src="${fn:escapeXml(pageContext.request.contextPath)}/assets/formularios.js" defer></script>
<script src="${fn:escapeXml(pageContext.request.contextPath)}/assets/daynest.js" defer></script>
</head><body>
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<header class="site-header"><div class="topbar">
<a class="brand" href="${fn:escapeXml(pageContext.request.contextPath)}/inicio" aria-label="DayNest, inicio"><img src="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/daynest-logo.svg" alt="" width="42" height="42"><b class="brand-word">Day<span>Nest</span></b></a>
<button class="nav-toggle" type="button" aria-controls="navegacion" aria-expanded="false" aria-label="Abrir menú"><svg class="icon" aria-hidden="true"><use href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/iconos.svg#menu"/></svg></button>
<nav id="navegacion" class="main-nav" aria-label="Menú principal">
<a href="${fn:escapeXml(pageContext.request.contextPath)}/buscar">Explorar alojamientos</a>
<div class="nav-actions">
<c:choose><c:when test="${empty sessionScope.usuario}">
<a href="${fn:escapeXml(pageContext.request.contextPath)}/registro">Publica tu espacio</a>
<a href="${fn:escapeXml(pageContext.request.contextPath)}/login">Iniciar sesión</a>
<a class="nav-join" href="${fn:escapeXml(pageContext.request.contextPath)}/registro">Crear cuenta</a>
</c:when><c:otherwise>
<details class="account-menu"><summary><c:out value="${sessionScope.usuario.nombre}"/> · Mi cuenta</summary><div class="account-links">
<c:if test="${sessionScope.usuario.cliente or sessionScope.usuario.propietario}"><a href="${fn:escapeXml(pageContext.request.contextPath)}/cuenta/perfiles">Mis perfiles</a></c:if>
<c:if test="${sessionScope.usuario.cliente}"><a href="${fn:escapeXml(pageContext.request.contextPath)}/cliente/reservas">Mis reservas</a><a href="${fn:escapeXml(pageContext.request.contextPath)}/cliente/historial">Historial</a></c:if>
<c:if test="${sessionScope.usuario.propietario}"><a href="${fn:escapeXml(pageContext.request.contextPath)}/propietario/inmuebles">Mis inmuebles</a><a href="${fn:escapeXml(pageContext.request.contextPath)}/propietario/reservas">Reservas recibidas</a><a href="${fn:escapeXml(pageContext.request.contextPath)}/propietario/giros">Mis giros</a></c:if>
<c:if test="${sessionScope.usuario.esAdministrador}"><a href="${fn:escapeXml(pageContext.request.contextPath)}/admin">Panel</a><a href="${fn:escapeXml(pageContext.request.contextPath)}/admin/inmuebles">Rentas</a><a href="${fn:escapeXml(pageContext.request.contextPath)}/admin/reservas">Reservas</a><a href="${fn:escapeXml(pageContext.request.contextPath)}/admin/pagos">Pagos</a><a href="${fn:escapeXml(pageContext.request.contextPath)}/admin/giros">Giros</a></c:if>

<form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/salir"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><button class="link-button" type="submit">Cerrar sesión</button></form>
</div></details></c:otherwise></c:choose>
</div></nav></div></header><main id="contenido">
<c:if test="${not empty sessionScope.flashMensaje}"><div role="status" class="alert ${sessionScope.flashTipo eq 'error' ? 'error' : ''}"><c:out value="${sessionScope.flashMensaje}"/></div><c:remove var="flashMensaje" scope="session"/><c:remove var="flashTipo" scope="session"/></c:if>
<c:if test="${not empty error}"><div class="alert error" role="alert"><c:out value="${error}"/></div></c:if>
