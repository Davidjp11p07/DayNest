<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${empty liquidaciones}"><p class="empty"><c:out value="${textos['ui246']}"/></p></c:when><c:otherwise>
<div class="table-wrap"><table><thead><tr><th><c:out value="${textos['ui024']}"/></th><th><c:out value="${textos['ui247']}"/></th><th><c:out value="${textos['ui200']}"/></th><th><c:out value="${textos['ui248']}"/></th><th><c:out value="${textos['ui249']}"/></th><th><c:out value="${textos['ui250']}"/></th></tr></thead><tbody>
<c:forEach var="l" items="${liquidaciones}"><tr><td>#<c:out value="${l.reservaId}"/></td><td><fmt:formatNumber value="${l.total}" pattern="#,##0.00"/> <c:out value="${l.moneda}"/></td><td><fmt:formatNumber value="${l.porcentaje}" type="percent" maxFractionDigits="2"/></td><td><fmt:formatNumber value="${l.neto}" pattern="#,##0.00"/> <c:out value="${l.moneda}"/></td><td><c:choose><c:when test="${empty l.destino}"><c:out value="${textos['ui251']}"/></c:when><c:otherwise><c:out value="${l.destino}"/></c:otherwise></c:choose></td><td><c:out value="${empty textos[l.estado.toString()] ? l.estado : textos[l.estado.toString()]}"/><br><c:out value="${l.motivo}"/><br><c:out value="${textos['ui252']}"/> <c:out value="${l.intentos}"/>
<c:if test="${sessionScope.usuario.esAdministrador and l.estado ne 'EJECUTADA'}"><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/admin/reintentar-liquidacion"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${l.reservaId}"><button type="submit"><c:out value="${textos['ui253']}"/></button></form></c:if>
</td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
