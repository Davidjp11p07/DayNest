<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${empty liquidaciones}"><p class="empty">No hay estancias por liquidar.</p></c:when><c:otherwise>
<div class="table-wrap"><table><thead><tr><th>Reserva</th><th>Total</th><th>Comisión</th><th>Neto</th><th>Cuenta de destino</th><th>Estado / motivo</th></tr></thead><tbody>
<c:forEach var="l" items="${liquidaciones}"><tr><td>#<c:out value="${l.reservaId}"/></td><td><fmt:formatNumber value="${l.total}" pattern="#,##0.00"/> <c:out value="${l.moneda}"/></td><td><fmt:formatNumber value="${l.porcentaje}" type="percent" maxFractionDigits="2"/></td><td><fmt:formatNumber value="${l.neto}" pattern="#,##0.00"/> <c:out value="${l.moneda}"/></td><td><c:choose><c:when test="${empty l.destino}">Cuenta pendiente de configurar</c:when><c:otherwise><c:out value="${l.destino}"/></c:otherwise></c:choose></td><td><c:out value="${l.estado}"/><br><c:out value="${l.motivo}"/><br>Revisiones: <c:out value="${l.intentos}"/>
<c:if test="${sessionScope.usuario.esAdministrador and l.estado ne 'EJECUTADA'}"><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/admin/reintentar-liquidacion"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${l.reservaId}"><button type="submit">Revisar ahora</button></form></c:if>
</td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
