<%@ page pageEncoding="UTF-8" %>
<form data-search-form action="${fn:escapeXml(pageContext.request.contextPath)}/buscar" method="get" class="panel filters" aria-label="${fn:escapeXml(textos['ui137'])}">
<div class="field"><label for="ciudad"><c:out value="${textos['ui138']}"/></label><input id="ciudad" name="ciudad" data-city-search type="text" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="ciudades-sugeridas" value="${fn:escapeXml(param.ciudad)}" maxlength="400" placeholder="${fn:escapeXml(textos['ui139'])}"><input type="hidden" name="ciudadId" value="${fn:escapeXml(param.ciudadId)}" data-city-id><ul id="ciudades-sugeridas" class="city-suggestions" role="listbox" hidden></ul><span class="sr-only" data-city-status aria-live="polite"></span></div>
<div class="field"><label for="entrada"><c:out value="${textos['ui074']}"/></label><input id="entrada" name="entrada" type="date" value="${fn:escapeXml(param.entrada)}"></div>
<div class="field"><label for="salida"><c:out value="${textos['ui075']}"/></label><input id="salida" name="salida" type="date" value="${fn:escapeXml(param.salida)}"></div>
<button class="search-submit" type="submit"><svg class="icon" aria-hidden="true"><use href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/iconos.svg#search"/></svg><c:out value="${textos['ui137']}"/></button>
<details class="filter-extras" ${(not empty param.minimo or not empty param.maximo or not empty param.capacidad or filtrosExtendidos) ? 'open' : ''}><summary><c:out value="${textos['ui140']}"/></summary><div class="extra-fields">
<div class="field"><label for="minimo"><c:out value="${textos['ui141']}"/></label><input id="minimo" name="minimo" type="number" value="${fn:escapeXml(param.minimo)}" min="0" step="0.01" placeholder="${fn:escapeXml(textos['ui142'])}"></div>
<div class="field"><label for="maximo"><c:out value="${textos['ui143']}"/></label><input id="maximo" name="maximo" type="number" value="${fn:escapeXml(param.maximo)}" min="0" step="0.01" placeholder="${fn:escapeXml(textos['ui144'])}"></div>
<div class="field"><label for="capacidad"><c:out value="${textos['ui145']}"/></label><input id="capacidad" name="capacidad" type="number" value="${fn:escapeXml(param.capacidad)}" min="1" placeholder="${fn:escapeXml(textos['ui146'])}"></div>
<div class="field"><label for="paisId"><c:out value="${textos['ui004']}"/></label><select id="paisId" name="paisId"><option value=""><c:out value="${textos['ui015']}"/></option><c:forEach var="opcion" items="${paises}"><option value="${fn:escapeXml(opcion.key)}" ${param.paisId == opcion.key ? 'selected' : ''}><c:out value="${opcion.value}"/></option></c:forEach></select></div><div class="field"><label for="divisionId"><c:out value="${textos['ui147']}"/></label><select id="divisionId" name="divisionId"><option value=""><c:out value="${textos['ui015']}"/></option><c:forEach var="opcion" items="${divisiones}"><option value="${fn:escapeXml(opcion.key)}" ${param.divisionId == opcion.key ? 'selected' : ''}><c:out value="${opcion.value}"/></option></c:forEach></select></div><div class="field"><label for="tipo"><c:out value="${textos['ui148']}"/></label><select id="tipo" name="tipo"><option value=""><c:out value="${textos['ui149']}"/></option><option value="APARTAMENTO" ${param.tipo eq 'APARTAMENTO' ? 'selected' : ''}><c:out value="${textos['ui150']}"/></option><option value="CASA" ${param.tipo eq 'CASA' ? 'selected' : ''}><c:out value="${textos['ui151']}"/></option><option value="CABAÑA" ${param.tipo eq 'CABAÑA' ? 'selected' : ''}><c:out value="${textos['ui152']}"/></option><option value="HABITACION" ${param.tipo eq 'HABITACION' ? 'selected' : ''}><c:out value="${textos['ui153']}"/></option><option value="OTRO" ${param.tipo eq 'OTRO' ? 'selected' : ''}><c:out value="${textos['ui154']}"/></option></select></div><div class="field"><label for="rural"><c:out value="${textos['ui155']}"/></label><select id="rural" name="rural"><option value=""><c:out value="${textos['ui156']}"/></option><option value="true" ${param.rural eq 'true' ? 'selected' : ''}><c:out value="${textos['ui157']}"/></option><option value="false" ${param.rural eq 'false' ? 'selected' : ''}><c:out value="${textos['ui158']}"/></option></select></div><div class="field"><label for="mar"><c:out value="${textos['ui159']}"/></label><select id="mar" name="mar"><option value=""><c:out value="${textos['ui156']}"/></option><option value="true" ${param.mar eq 'true' ? 'selected' : ''}><c:out value="${textos['ui157']}"/></option><option value="false" ${param.mar eq 'false' ? 'selected' : ''}><c:out value="${textos['ui158']}"/></option></select></div></div></details></form>
<%@ include file="ciudades.jspf" %>
