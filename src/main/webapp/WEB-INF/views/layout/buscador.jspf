<%@ page pageEncoding="UTF-8" %>
<form action="${fn:escapeXml(pageContext.request.contextPath)}/buscar" method="get" class="panel filters" aria-label="Buscar alojamiento">
<div class="field"><label for="ciudad">¿A dónde quieres ir?</label><input id="ciudad" name="ciudad" data-city-search type="text" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="ciudades-sugeridas" value="${fn:escapeXml(param.ciudad)}" maxlength="400" placeholder="Escribe una ciudad"><input type="hidden" name="ciudadId" value="${fn:escapeXml(param.ciudadId)}" data-city-id><ul id="ciudades-sugeridas" class="city-suggestions" role="listbox" hidden></ul><span class="sr-only" data-city-status aria-live="polite"></span></div>
<div class="field"><label for="entrada">Entrada</label><input id="entrada" name="entrada" type="date" value="${fn:escapeXml(param.entrada)}"></div>
<div class="field"><label for="salida">Salida</label><input id="salida" name="salida" type="date" value="${fn:escapeXml(param.salida)}"></div>
<button class="search-submit" type="submit"><svg class="icon" aria-hidden="true"><use href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/iconos.svg#search"/></svg>Buscar alojamiento</button>
<details class="filter-extras" ${(not empty param.minimo or not empty param.maximo or not empty param.capacidad or filtrosExtendidos) ? 'open' : ''}><summary>Todos los filtros</summary><div class="extra-fields">
<div class="field"><label for="minimo">Precio mínimo / noche (moneda del alojamiento)</label><input id="minimo" name="minimo" type="number" value="${fn:escapeXml(param.minimo)}" min="0" step="0.01" placeholder="Desde"></div>
<div class="field"><label for="maximo">Precio máximo / noche (moneda del alojamiento)</label><input id="maximo" name="maximo" type="number" value="${fn:escapeXml(param.maximo)}" min="0" step="0.01" placeholder="Hasta"></div>
<div class="field"><label for="capacidad">Capacidad mínima</label><input id="capacidad" name="capacidad" type="number" value="${fn:escapeXml(param.capacidad)}" min="1" placeholder="Número de huéspedes"></div>
<div class="field"><label for="paisId">País</label><select id="paisId" name="paisId"><option value="">Todos</option><c:forEach var="opcion" items="${paises}"><option value="${fn:escapeXml(opcion.key)}" ${param.paisId == opcion.key ? 'selected' : ''}><c:out value="${opcion.value}"/></option></c:forEach></select></div><div class="field"><label for="divisionId">Departamento o región</label><select id="divisionId" name="divisionId"><option value="">Todos</option><c:forEach var="opcion" items="${divisiones}"><option value="${fn:escapeXml(opcion.key)}" ${param.divisionId == opcion.key ? 'selected' : ''}><c:out value="${opcion.value}"/></option></c:forEach></select></div><div class="field"><label for="tipo">Tipo de inmueble</label><select id="tipo" name="tipo"><option value="">Todos los tipos</option><option value="APARTAMENTO" ${param.tipo eq 'APARTAMENTO' ? 'selected' : ''}>Apartamento</option><option value="CASA" ${param.tipo eq 'CASA' ? 'selected' : ''}>Casa</option><option value="CABAÑA" ${param.tipo eq 'CABAÑA' ? 'selected' : ''}>Cabaña</option><option value="HABITACION" ${param.tipo eq 'HABITACION' ? 'selected' : ''}>Habitación</option><option value="OTRO" ${param.tipo eq 'OTRO' ? 'selected' : ''}>Otro</option></select></div><div class="field"><label for="rural">En el campo</label><select id="rural" name="rural"><option value="">Cualquier entorno</option><option value="true" ${param.rural eq 'true' ? 'selected' : ''}>Sí, confirmado</option><option value="false" ${param.rural eq 'false' ? 'selected' : ''}>No, confirmado</option></select></div><div class="field"><label for="mar">Junto al mar</label><select id="mar" name="mar"><option value="">Cualquier entorno</option><option value="true" ${param.mar eq 'true' ? 'selected' : ''}>Sí, confirmado</option><option value="false" ${param.mar eq 'false' ? 'selected' : ''}>No, confirmado</option></select></div></div></details></form>
<%@ include file="ciudades.jspf" %>
