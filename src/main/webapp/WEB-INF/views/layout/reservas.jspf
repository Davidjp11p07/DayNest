<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${empty reservas}"><p class="empty"><c:out value="${textos['ui275']}"/></p></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th><c:out value="${textos['ui225']}"/></th><th><c:out value="${textos['ui025']}"/></th><th><c:out value="${textos['ui276']}"/></th><th><c:out value="${textos['ui199']}"/></th><th><c:out value="${textos['ui028']}"/></th><th><c:out value="${textos['ui277']}"/></th></tr></thead><tbody><c:forEach var="r" items="${reservas}"><tr data-reserva-id="${fn:escapeXml(r.id)}"><td>#<c:out value="${r.id}"/><br><c:out value="${r.inmueble.titulo}"/></td><td><c:out value="${r.cliente.nombre}"/></td><td><c:out value="${r.periodo.entrada}"/> → <c:out value="${r.periodo.salida}"/><br><c:out value="${r.huespedes}"/> <c:out value="${textos['ui244']}"/></td><td><fmt:formatNumber value="${r.total}" pattern="#,##0.00"/> <c:out value="${r.moneda}"/><c:if test="${not empty resumenes}"><br><c:out value="${textos['ui278']}"/> <fmt:formatNumber value="${resumenes[r.id].totalPagado}" pattern="#,##0.00"/><br><c:out value="${textos['ui279']}"/> <fmt:formatNumber value="${resumenes[r.id].saldo}" pattern="#,##0.00"/> <c:out value="${r.moneda}"/></c:if></td><td><span class="badge" data-estado="${fn:escapeXml(r.estado)}"><c:out value="${empty textos[r.estado.toString()] ? r.estado : textos[r.estado.toString()]}"/></span></td><td><div class="actions">
<c:if test="${rolReservas eq 'CLIENTE'}"><a class="button secondary" href="${fn:escapeXml(pageContext.request.contextPath)}/cliente/reserva?id=${fn:escapeXml(r.id)}" aria-label="${fn:escapeXml(textos['ui280'])} ${fn:escapeXml(r.id)}"><c:out value="${textos['ui280']}"/></a></c:if>
<c:if test="${sessionScope.usuario.cliente and r.cliente.id eq sessionScope.usuario.id and (r.estado eq 'PENDIENTE_PAGO' or r.estado eq 'CONFIRMADA') and r.periodo.entrada.isAfter(hoy)}"><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/cliente/cancelar"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(r.id)}"><button type="submit" class="danger"><c:out value="${textos['ui281']}"/></button></form></c:if>
<c:if test="${sessionScope.usuario.esAdministrador and (r.estado eq 'PENDIENTE_PAGO' or r.estado eq 'CONFIRMADA') and r.periodo.entrada.isAfter(hoy)}"><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/admin/cancelar"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(r.id)}"><button type="submit" class="danger"><c:out value="${textos['ui281']}"/></button></form></c:if>
<c:if test="${sessionScope.usuario.esAdministrador and not girosAutomaticos and girables.contains(r.id)}"><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/admin/generar-giro" class="form-inline"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(r.id)}"><label class="sr-only" for="giro-${fn:escapeXml(r.id)}"><c:out value="${textos['ui282']}"/></label><input id="giro-${fn:escapeXml(r.id)}" name="referencia" maxlength="120" placeholder="${fn:escapeXml(textos['ui283'])}"><button type="submit"><c:out value="${textos['ui284']}"/></button></form></c:if>
<c:if test="${r.estado eq 'FINALIZADA' and rolReservas eq 'CLIENTE' and not calificados[r.id]}"><details class="review-form"><summary><c:out value="${textos['ui285']}"/></summary><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/cliente/calificar" class="form-stack"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(r.id)}"><div class="field"><label for="puntuacion-cliente-${fn:escapeXml(r.id)}"><c:out value="${textos['ui286']}"/></label><select required id="puntuacion-cliente-${fn:escapeXml(r.id)}" name="puntuacion"><option value=""><c:out value="${textos['ui287']}"/></option><option value="5"><c:out value="${textos['ui288']}"/></option><option value="4"><c:out value="${textos['ui289']}"/></option><option value="3"><c:out value="${textos['ui290']}"/></option><option value="2"><c:out value="${textos['ui291']}"/></option><option value="1"><c:out value="${textos['ui292']}"/></option></select></div><div class="field"><label for="comentario-cliente-${fn:escapeXml(r.id)}"><c:out value="${textos['ui293']}"/></label><textarea id="comentario-cliente-${fn:escapeXml(r.id)}" name="comentario" maxlength="1000"></textarea></div><button type="submit"><c:out value="${textos['ui294']}"/></button></form></details></c:if>
<c:if test="${rolReservas eq 'PROPIETARIO' and not empty calificacionesClientes[r.cliente.id]}"><details class="guest-reviews"><summary><c:out value="${textos['ui295']}"/><c:out value="${fn:length(calificacionesClientes[r.cliente.id])}"/>)</summary><div class="reviews"><c:forEach var="calificacion" items="${calificacionesClientes[r.cliente.id]}"><article class="review"><strong><c:out value="${calificacion.puntuacion}"/><c:out value="${textos['ui296']}"/><c:out value="${calificacion.reservaId}"/></strong><c:if test="${not empty calificacion.comentario}"><p><c:out value="${calificacion.comentario}"/></p></c:if></article></c:forEach></div></details></c:if>
<c:if test="${r.estado eq 'FINALIZADA' and rolReservas eq 'PROPIETARIO' and not calificados[r.id]}"><details class="review-form"><summary><c:out value="${textos['ui297']}"/></summary><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/propietario/calificar" class="form-stack"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(r.id)}"><div class="field"><label for="puntuacion-propietario-${fn:escapeXml(r.id)}"><c:out value="${textos['ui286']}"/></label><select required id="puntuacion-propietario-${fn:escapeXml(r.id)}" name="puntuacion"><option value=""><c:out value="${textos['ui287']}"/></option><option value="5"><c:out value="${textos['ui288']}"/></option><option value="4"><c:out value="${textos['ui289']}"/></option><option value="3"><c:out value="${textos['ui290']}"/></option><option value="2"><c:out value="${textos['ui291']}"/></option><option value="1"><c:out value="${textos['ui292']}"/></option></select></div><div class="field"><label for="comentario-propietario-${fn:escapeXml(r.id)}"><c:out value="${textos['ui293']}"/></label><textarea id="comentario-propietario-${fn:escapeXml(r.id)}" name="comentario" maxlength="1000"></textarea></div><button type="submit"><c:out value="${textos['ui294']}"/></button></form></details></c:if>
<c:if test="${r.estado eq 'FINALIZADA' and calificados[r.id] and (rolReservas eq 'CLIENTE' or rolReservas eq 'PROPIETARIO')}"><span class="badge"><c:out value="${textos['ui298']}"/></span></c:if>
</div></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
<c:set var="paginacion" value="${navReservas}"/><%@ include file="paginador.jspf" %>
