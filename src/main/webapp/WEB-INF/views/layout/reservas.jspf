<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${empty reservas}"><p class="empty">No hay reservas para mostrar.</p></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Reserva / inmueble</th><th>Cliente</th><th>Fechas / huéspedes</th><th>Total / moneda</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><c:forEach var="r" items="${reservas}"><tr data-reserva-id="${fn:escapeXml(r.id)}"><td>#<c:out value="${r.id}"/><br><c:out value="${r.inmueble.titulo}"/></td><td><c:out value="${r.cliente.nombre}"/></td><td><c:out value="${r.periodo.entrada}"/> → <c:out value="${r.periodo.salida}"/><br><c:out value="${r.huespedes}"/> huéspedes</td><td><fmt:formatNumber value="${r.total}" pattern="#,##0.00"/> <c:out value="${r.moneda}"/><c:if test="${not empty resumenes}"><br>Pagado: <fmt:formatNumber value="${resumenes[r.id].totalPagado}" pattern="#,##0.00"/><br>Saldo: <fmt:formatNumber value="${resumenes[r.id].saldo}" pattern="#,##0.00"/> <c:out value="${r.moneda}"/></c:if></td><td><span class="badge" data-estado="${fn:escapeXml(r.estado)}"><c:out value="${r.estado}"/></span></td><td><div class="actions">
<c:if test="${sessionScope.usuario.cliente and r.cliente.id eq sessionScope.usuario.id and (r.estado eq 'PENDIENTE_PAGO' or r.estado eq 'CONFIRMADA') and r.periodo.entrada.isAfter(hoy)}"><c:if test="${r.estado eq 'PENDIENTE_PAGO'}"><a class="button secondary" href="${fn:escapeXml(pageContext.request.contextPath)}/cliente/pagar?id=${fn:escapeXml(r.id)}">Pagar</a></c:if><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/cliente/cancelar"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(r.id)}"><button type="submit" class="danger">Cancelar</button></form></c:if>
<c:if test="${sessionScope.usuario.esAdministrador and (r.estado eq 'PENDIENTE_PAGO' or r.estado eq 'CONFIRMADA') and r.periodo.entrada.isAfter(hoy)}"><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/admin/cancelar"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(r.id)}"><button type="submit" class="danger">Cancelar</button></form></c:if>
<c:if test="${sessionScope.usuario.esAdministrador and girables.contains(r.id)}"><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/admin/generar-giro" class="form-inline"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(r.id)}"><label class="sr-only" for="giro-${fn:escapeXml(r.id)}">Referencia del giro</label><input id="giro-${fn:escapeXml(r.id)}" name="referencia" maxlength="120" placeholder="Referencia del giro (opcional)"><button type="submit">Generar giro</button></form></c:if>
</div></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
<c:set var="paginacion" value="${navReservas}"/><%@ include file="paginador.jspf" %>
