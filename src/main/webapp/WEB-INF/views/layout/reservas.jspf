<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${empty reservas}"><p class="empty">No hay reservas para mostrar.</p></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Reserva / inmueble</th><th>Cliente</th><th>Fechas / huéspedes</th><th>Total / moneda</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><c:forEach var="r" items="${reservas}"><tr data-reserva-id="${fn:escapeXml(r.id)}"><td>#<c:out value="${r.id}"/><br><c:out value="${r.inmueble.titulo}"/></td><td><c:out value="${r.cliente.nombre}"/></td><td><c:out value="${r.periodo.entrada}"/> → <c:out value="${r.periodo.salida}"/><br><c:out value="${r.huespedes}"/> huéspedes</td><td><fmt:formatNumber value="${r.total}" pattern="#,##0.00"/> <c:out value="${r.moneda}"/><c:if test="${not empty resumenes}"><br>Pagado: <fmt:formatNumber value="${resumenes[r.id].totalPagado}" pattern="#,##0.00"/><br>Saldo: <fmt:formatNumber value="${resumenes[r.id].saldo}" pattern="#,##0.00"/> <c:out value="${r.moneda}"/></c:if></td><td><span class="badge" data-estado="${fn:escapeXml(r.estado)}"><c:out value="${r.estado}"/></span></td><td><div class="actions">
<c:if test="${sessionScope.usuario.cliente and r.cliente.id eq sessionScope.usuario.id and (r.estado eq 'PENDIENTE_PAGO' or r.estado eq 'CONFIRMADA') and r.periodo.entrada.isAfter(hoy)}"><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/cliente/cancelar"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(r.id)}"><button type="submit" class="danger">Cancelar</button></form></c:if>
<c:if test="${sessionScope.usuario.esAdministrador and (r.estado eq 'PENDIENTE_PAGO' or r.estado eq 'CONFIRMADA') and r.periodo.entrada.isAfter(hoy)}"><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/admin/cancelar"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(r.id)}"><button type="submit" class="danger">Cancelar</button></form></c:if>
<c:if test="${sessionScope.usuario.esAdministrador and not girosAutomaticos and girables.contains(r.id)}"><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/admin/generar-giro" class="form-inline"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(r.id)}"><label class="sr-only" for="giro-${fn:escapeXml(r.id)}">Referencia del giro</label><input id="giro-${fn:escapeXml(r.id)}" name="referencia" maxlength="120" placeholder="Referencia del giro (opcional)"><button type="submit">Generar giro</button></form></c:if>
<c:if test="${r.estado eq 'FINALIZADA' and rolReservas eq 'CLIENTE' and not calificados[r.id]}"><details class="review-form"><summary>Calificar inmueble y estadía</summary><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/cliente/calificar" class="form-stack"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(r.id)}"><div class="field"><label for="puntuacion-cliente-${fn:escapeXml(r.id)}">Calificación</label><select required id="puntuacion-cliente-${fn:escapeXml(r.id)}" name="puntuacion"><option value="">Elige de 1 a 5</option><option value="5">5 · Excelente</option><option value="4">4 · Muy bueno</option><option value="3">3 · Bueno</option><option value="2">2 · Regular</option><option value="1">1 · Malo</option></select></div><div class="field"><label for="comentario-cliente-${fn:escapeXml(r.id)}">Comentario (opcional)</label><textarea id="comentario-cliente-${fn:escapeXml(r.id)}" name="comentario" maxlength="1000"></textarea></div><button type="submit">Enviar calificación</button></form></details></c:if>
<c:if test="${rolReservas eq 'PROPIETARIO' and not empty calificacionesClientes[r.cliente.id]}"><details class="guest-reviews"><summary>Historial de calificaciones del huésped (<c:out value="${fn:length(calificacionesClientes[r.cliente.id])}"/>)</summary><div class="reviews"><c:forEach var="calificacion" items="${calificacionesClientes[r.cliente.id]}"><article class="review"><strong><c:out value="${calificacion.puntuacion}"/>/5 · Reserva #<c:out value="${calificacion.reservaId}"/></strong><c:if test="${not empty calificacion.comentario}"><p><c:out value="${calificacion.comentario}"/></p></c:if></article></c:forEach></div></details></c:if>
<c:if test="${r.estado eq 'FINALIZADA' and rolReservas eq 'PROPIETARIO' and not calificados[r.id]}"><details class="review-form"><summary>Calificar huésped</summary><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/propietario/calificar" class="form-stack"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(r.id)}"><div class="field"><label for="puntuacion-propietario-${fn:escapeXml(r.id)}">Calificación</label><select required id="puntuacion-propietario-${fn:escapeXml(r.id)}" name="puntuacion"><option value="">Elige de 1 a 5</option><option value="5">5 · Excelente</option><option value="4">4 · Muy bueno</option><option value="3">3 · Bueno</option><option value="2">2 · Regular</option><option value="1">1 · Malo</option></select></div><div class="field"><label for="comentario-propietario-${fn:escapeXml(r.id)}">Comentario (opcional)</label><textarea id="comentario-propietario-${fn:escapeXml(r.id)}" name="comentario" maxlength="1000"></textarea></div><button type="submit">Enviar calificación</button></form></details></c:if>
<c:if test="${r.estado eq 'FINALIZADA' and calificados[r.id] and (rolReservas eq 'CLIENTE' or rolReservas eq 'PROPIETARIO')}"><span class="badge">Calificación enviada</span></c:if>
</div></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
<c:set var="paginacion" value="${navReservas}"/><%@ include file="paginador.jspf" %>
