<%@ page pageEncoding="UTF-8" %>
<%@ include file="../layout/cabecera.jspf" %>
<h1>Gestión de rentas</h1><form method="get" action="${fn:escapeXml(pageContext.request.contextPath)}/admin/inmuebles" class="panel form-inline"><label for="estado">Estado del inmueble</label><select id="estado" name="estado"><option value="">Todos</option><option value="PUBLICADO" ${param.estado eq 'PUBLICADO' ? 'selected' : ''}>Activo</option><option value="INACTIVO" ${param.estado eq 'INACTIVO' ? 'selected' : ''}>Inactivo</option></select><button type="submit">Aplicar filtro</button></form><br><c:if test="${empty inmuebles}"><p class="empty">No hay inmuebles con este estado.</p></c:if><div class="table-wrap"><table><thead><tr><th>Inmueble</th><th>Propietario</th><th>Ciudad</th><th>Tarifa / moneda</th><th>Estado</th><th>Acción</th></tr></thead><tbody><c:forEach var="i" items="${inmuebles}"><tr><td><c:out value="${i.titulo}"/></td><td><c:out value="${i.propietario.nombre}"/></td><td><c:out value="${i.ciudad}"/></td><td><fmt:formatNumber value="${i.precioPorNoche}" pattern="#,##0.00"/> <c:out value="${i.moneda}"/></td><td><c:out value="${i.estado}"/></td><td><c:if test="${i.estado eq 'PUBLICADO'}"><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/admin/desactivar"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(i.id)}"><button type="submit" class="danger">Desactivar</button></form></c:if></td></tr></c:forEach></tbody></table></div>
<c:set var="paginacion" value="${navInmuebles}"/><%@ include file="../layout/paginador.jspf" %>
<%@ include file="../layout/pie.jspf" %>
