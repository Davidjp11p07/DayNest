<%@ page pageEncoding="UTF-8" %>
<%@ include file="../layout/cabecera.jspf" %>
<h1><c:out value="${textos['ui031']}"/></h1><form method="get" action="${fn:escapeXml(pageContext.request.contextPath)}/admin/inmuebles" class="panel form-inline"><label for="estado"><c:out value="${textos['ui032']}"/></label><select id="estado" name="estado"><option value=""><c:out value="${textos['ui015']}"/></option><option value="PUBLICADO" ${param.estado eq 'PUBLICADO' ? 'selected' : ''}><c:out value="${textos['ui033']}"/></option><option value="INACTIVO" ${param.estado eq 'INACTIVO' ? 'selected' : ''}><c:out value="${textos['ui034']}"/></option></select><button type="submit"><c:out value="${textos['ui021']}"/></button></form><br><c:if test="${empty inmuebles}"><p class="empty"><c:out value="${textos['ui035']}"/></p></c:if><div class="table-wrap"><table><thead><tr><th><c:out value="${textos['ui026']}"/></th><th><c:out value="${textos['ui036']}"/></th><th><c:out value="${textos['ui037']}"/></th><th><c:out value="${textos['ui038']}"/></th><th><c:out value="${textos['ui028']}"/></th><th><c:out value="${textos['ui039']}"/></th></tr></thead><tbody><c:forEach var="i" items="${inmuebles}"><tr><td><c:out value="${i.titulo}"/></td><td><c:out value="${i.propietario.nombre}"/></td><td><c:out value="${i.ciudad}"/></td><td><fmt:formatNumber value="${i.precioPorNoche}" pattern="#,##0.00"/> <c:out value="${i.moneda}"/></td><td><c:out value="${empty textos[i.estado.toString()] ? i.estado : textos[i.estado.toString()]}"/></td><td><c:if test="${i.estado eq 'PUBLICADO'}"><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/admin/desactivar"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(i.id)}"><button type="submit" class="danger"><c:out value="${textos['ui040']}"/></button></form></c:if></td></tr></c:forEach></tbody></table></div>
<c:set var="paginacion" value="${navInmuebles}"/><%@ include file="../layout/paginador.jspf" %>
