<a href="${fn:escapeXml(pageContext.request.contextPath)}/admin/historial-anterior">Consultar historial anterior a la migración</a><h1>Panel de administración</h1><p class="muted">Una vista general de los alojamientos, las estadías y los movimientos registrados.</p><div class="grid"><div class="card stat"><strong><c:out value="${totalInmuebles}"/></strong><a href="${fn:escapeXml(pageContext.request.contextPath)}/admin/inmuebles">Inmuebles</a></div><div class="card stat"><strong><c:out value="${totalReservas}"/></strong><a href="${fn:escapeXml(pageContext.request.contextPath)}/admin/reservas">Reservas</a></div><div class="card stat"><strong><c:out value="${totalPagos}"/></strong><a href="${fn:escapeXml(pageContext.request.contextPath)}/admin/pagos">Pagos</a></div><div class="card stat"><strong><c:out value="${totalGiros}"/></strong><a href="${fn:escapeXml(pageContext.request.contextPath)}/admin/giros">Giros</a></div></div><h2>Resumen financiero</h2><div class="grid"><div class="panel"><span class="muted">Pagos registrados</span><c:forEach var="importe" items="${pagosPorMoneda}"><p class="price"><fmt:formatNumber value="${importe.value}" pattern="#,##0.00"/> <c:out value="${importe.key}"/></p></c:forEach></div><div class="panel"><span class="muted">Giros netos registrados</span><c:forEach var="importe" items="${girosPorMoneda}"><p class="price"><fmt:formatNumber value="${importe.value}" pattern="#,##0.00"/> <c:out value="${importe.key}"/></p></c:forEach></div></div>
