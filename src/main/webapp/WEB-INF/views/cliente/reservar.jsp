<%@ page pageEncoding="UTF-8" %>
<%@ include file="../layout/cabecera.jspf" %>
<section class="panel narrow"><h1>Reserva tu estadía</h1><h2><c:out value="${inmueble.titulo}"/></h2><p><fmt:formatNumber value="${inmueble.precioPorNoche}" pattern="#,##0.00"/> <c:out value="${inmueble.moneda}"/> por noche · hasta <c:out value="${inmueble.capacidad}"/> huéspedes.</p><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/cliente/reservar" class="form-stack" data-reserva data-moneda="${fn:escapeXml(inmueble.moneda)}" data-precio="${fn:escapeXml(inmueble.precioPorNoche)}"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="inmuebleId" value="${fn:escapeXml(inmueble.id)}"><div class="field"><label for="entrada">Fecha de entrada</label><input id="entrada" name="entrada" value="${fn:escapeXml(form.entrada)}" min="${fn:escapeXml(minEntrada)}" type="date" required></div><div class="field"><label for="salida">Fecha de salida</label><input id="salida" name="salida" value="${fn:escapeXml(form.salida)}" min="${fn:escapeXml(minEntrada)}" type="date" required></div><div class="field"><label for="huespedes">Huéspedes</label><input id="huespedes" name="huespedes" value="${fn:escapeXml(form.huespedes)}" type="number" required min="1" max="${fn:escapeXml(inmueble.capacidad)}"></div><div class="total" id="total-reserva" aria-live="polite">Seleccione las fechas para calcular el total.</div><small>El total definitivo se calcula al crear la reserva. Puede cancelar antes de la entrada con devolución simulada. La pendiente vence a los 30 minutos.</small><button type="submit">Crear reserva pendiente</button></form></section><script src="${fn:escapeXml(pageContext.request.contextPath)}/assets/reserva.js" defer></script>
<%@ include file="../layout/pie.jspf" %>
