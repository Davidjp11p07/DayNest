<%@ page pageEncoding="UTF-8" %>
<div class="field"><label for="cuentaPago"><c:out value="${textos['ui055']}"/></label>
<select id="cuentaPago" name="cuentaPago" required>
<c:if test="${not empty cuentaRegistrada}"><option value="REGISTRADA" ${form.cuentaPago ne 'OCASIONAL' ? 'selected' : ''}><c:out value="${textos['ui056']}"/></option></c:if>
<option value="OCASIONAL" ${form.cuentaPago eq 'OCASIONAL' or empty cuentaRegistrada ? 'selected' : ''}><c:out value="${textos['ui057']}"/></option>
</select></div>
<c:if test="${not empty cuentaRegistrada}">
<p data-cuenta-registrada>
<c:forEach var="b" items="${bancos}"><c:if test="${b.id eq cuentaRegistrada.bancoId}"><c:out value="${b.etiqueta}"/></c:if></c:forEach>
· <c:out value="${cuentaRegistrada.tipoCuenta}"/> <c:out value="${textos['ui058']}"/> <c:out value="${fn:substring(cuentaRegistrada.numeroCuenta,fn:length(cuentaRegistrada.numeroCuenta)-4,fn:length(cuentaRegistrada.numeroCuenta))}"/>
</p></c:if>
<c:if test="${empty cuentaRegistrada}"><p class="muted"><c:out value="${textos['ui059']}"/></p></c:if>
<fieldset data-cuenta-ocasional><legend><c:out value="${textos['ui060']}"/></legend>
<p class="muted"><c:out value="${textos['ui061']}"/></p>
<div class="field"><label for="bancoId"><c:out value="${textos['ui062']}"/></label><select id="bancoId" name="bancoId"><option value=""><c:out value="${textos['ui063']}"/></option><c:forEach var="b" items="${bancos}"><option value="${b.id}" ${form.bancoId eq b.id ? 'selected' : ''}><c:out value="${b.etiqueta}"/></option></c:forEach></select></div>
<div class="field"><label for="numeroCuenta"><c:out value="${textos['ui064']}"/></label><input id="numeroCuenta" name="numeroCuenta" type="text" inputmode="numeric" pattern="[0-9]{4,34}" minlength="4" maxlength="34" autocomplete="off" value="${fn:escapeXml(form.numeroCuenta)}"></div>
<div class="field"><label for="tipoCuenta"><c:out value="${textos['ui065']}"/></label><select id="tipoCuenta" name="tipoCuenta"><option value=""><c:out value="${textos['ui066']}"/></option><option value="AHORROS" ${form.tipoCuenta eq 'AHORROS' ? 'selected' : ''}><c:out value="${textos['ui067']}"/></option><option value="CORRIENTE" ${form.tipoCuenta eq 'CORRIENTE' ? 'selected' : ''}><c:out value="${textos['ui068']}"/></option></select></div>
</fieldset>
<div class="field"><label for="referencia"><c:out value="${textos['ui069']}"/></label><input id="referencia" name="referencia" type="text" maxlength="120" value="${fn:escapeXml(form.referencia)}"></div>
