<%@ page pageEncoding="UTF-8" %>
<%@ include file="../layout/cabecera.jspf" %>
<section class="panel narrow"><p class="alert">Simulación académica: no se cobra dinero real. El medio seleccionado no se guarda en este modelo.</p><h1>Registrar pago</h1><p>Reserva #<c:out value="${reserva.id}"/> · <c:out value="${reserva.inmueble.titulo}"/></p><div class="total">Total: <fmt:formatNumber value="${reserva.total}" pattern="#,##0.00"/> <c:out value="${reserva.moneda}"/></div><p>Pagado: <fmt:formatNumber value="${resumen.totalPagado}" pattern="#,##0.00"/> <c:out value="${reserva.moneda}"/> · Saldo: <fmt:formatNumber value="${resumen.saldo}" pattern="#,##0.00"/> <c:out value="${reserva.moneda}"/></p><p class="muted">Registra la referencia de tu pago. La reserva quedará confirmada al guardar.</p><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/cliente/pagar" class="form-stack"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(reserva.id)}"><div class="field"><label for="metodo">Método de pago</label><select id="metodo" name="metodo"><option value="TRANSFERENCIA" ${form.metodo eq 'TRANSFERENCIA' ? 'selected' : ''}>Transferencia</option><option value="TARJETA" ${form.metodo eq 'TARJETA' ? 'selected' : ''}>Tarjeta</option><option value="EFECTIVO" ${form.metodo eq 'EFECTIVO' ? 'selected' : ''}>Efectivo</option></select></div><div class="field"><label for="referencia">Referencia del pago (opcional)</label><input id="referencia" name="referencia" value="${fn:escapeXml(form.referencia)}" type="text" maxlength="120"></div><button type="submit">Registrar pago y confirmar</button></form></section>
<%@ include file="../layout/pie.jspf" %>
