<%@ page pageEncoding="UTF-8" %>
<%@ include file="../layout/cabecera.jspf" %>
<%@ include file="../layout/imagenes.jspf" %>
<c:set var="fotoPrincipal" value="${fotosDayNest[(inmueble.id - 1) % fn:length(fotosDayNest)]}"/>
<a class="breadcrumb" href="${fn:escapeXml(pageContext.request.contextPath)}/buscar">← Volver a los alojamientos</a>
<div class="detail-heading"><h1><c:out value="${inmueble.titulo}"/></h1><p class="detail-location"><svg class="icon" aria-hidden="true"><use href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/iconos.svg#pin"/></svg><c:out value="${inmueble.ciudad}"/> · Hasta <c:out value="${inmueble.capacidad}"/> huéspedes</p></div>
<div class="gallery" aria-label="Galería de referencias visuales">
<button type="button" data-photo aria-label="Ampliar foto principal de referencia"><img src="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/${fn:escapeXml(fotoPrincipal)}" alt="Foto principal ilustrativa para ${fn:escapeXml(inmueble.titulo)}" width="800" height="600"></button>
<c:forEach var="foto" items="${fn:split('interior-01.jpg,apto-02.jpg,casa-02.jpg,finca-01.jpg', ',')}" varStatus="pos"><button type="button" data-photo aria-label="Ampliar referencia editorial ${fn:escapeXml(pos.count)}"><img src="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/${fn:escapeXml(foto)}" alt="Referencia editorial ${fn:escapeXml(pos.count)}; no es una foto verificada de este inmueble" width="400" height="300" loading="lazy"></button></c:forEach>
</div><p class="editorial-note">Galería ilustrativa: estas fotos de referencia no representan necesariamente el inmueble publicado.</p>
<div class="detail-columns"><div class="detail-content"><section><span class="eyebrow">Tu alojamiento</span><h2>Un espacio para tus planes</h2><p class="description"><c:out value="${inmueble.descripcion}"/></p><p class="capacity"><svg class="icon" aria-hidden="true"><use href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/iconos.svg#users"/></svg>Capacidad máxima: <c:out value="${inmueble.capacidad}"/> huéspedes</p></section>
<section><h2>Detalles del inmueble</h2><p>Area: <c:choose><c:when test="${not empty inmueble.areaM2}"><fmt:formatNumber value="${inmueble.areaM2}"/> m²</c:when><c:otherwise>Pendiente de completar</c:otherwise></c:choose></p><p>Habitaciones: <c:choose><c:when test="${not empty inmueble.habitaciones}"><c:out value="${inmueble.habitaciones}"/></c:when><c:otherwise>Pendiente de completar</c:otherwise></c:choose></p></section><section><h2>Dónde te vas a quedar</h2><p><strong><c:out value="${inmueble.ciudad}"/></strong></p><p><c:out value="${inmueble.direccion}"/></p></section>
<section><h2>Conoce a tu propietario</h2><div class="host-line"><span class="host-icon"><svg class="icon" aria-hidden="true"><use href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/iconos.svg#house"/></svg></span><div><p><strong><c:out value="${inmueble.propietario.nombre}"/></strong></p><p class="muted">Propietario de este alojamiento</p></div></div></section></div>
<aside class="panel reservation-card" aria-labelledby="titulo-estimacion"><h2 id="titulo-estimacion" class="sr-only">Estima tu estadía</h2><p class="price"><fmt:formatNumber value="${inmueble.precioPorNoche}" pattern="#,##0.00"/> <span class="price-currency"><c:out value="${inmueble.moneda}"/></span></p><p class="muted">por noche</p>
<form method="get" action="${fn:escapeXml(pageContext.request.contextPath)}/cliente/reservar"><input type="hidden" name="id" value="${fn:escapeXml(inmueble.id)}"><div data-estimacion data-moneda="${fn:escapeXml(inmueble.moneda)}" data-precio="${fn:escapeXml(inmueble.precioPorNoche)}" class="form-stack"><div class="date-pair"><div class="field"><label for="estimacion-entrada">Entrada</label><input id="estimacion-entrada" name="entrada" value="${fn:escapeXml(form.entrada)}" min="${fn:escapeXml(minEntrada)}" type="date" data-entrada></div><div class="field"><label for="estimacion-salida">Salida</label><input id="estimacion-salida" name="salida" value="${fn:escapeXml(form.salida)}" min="${fn:escapeXml(minEntrada)}" type="date" data-salida></div></div>
<div class="estimate-line"><span data-noches>Elige las fechas</span><span data-subtotal>—</span></div><div class="estimate-line estimate-total" aria-live="polite"><span>Total estimado</span><span data-total>—</span></div></div>
<div class="field"><label for="detalle-huespedes">Huéspedes</label><input id="detalle-huespedes" name="huespedes" type="number" min="1" max="${fn:escapeXml(inmueble.capacidad)}" value="${fn:escapeXml(form.huespedes)}" placeholder="Cantidad de huéspedes"></div><button type="submit">Continuar con la reserva</button></form>
<small>Noches × tarifa por noche. La salida no cuenta como una noche adicional. Confirma las fechas en el formulario de reserva; allí se verifica la disponibilidad. Crear una reserva pendiente no registra un pago.</small><noscript><p class="auth-note">Para estimar el total, multiplica las noches por la tarifa. El total definitivo se calcula al crear la reserva.</p></noscript></aside></div>
<dialog class="photo-modal" id="galeria-modal" aria-labelledby="titulo-galeria"><div class="modal-head"><h2 id="titulo-galeria">Una mirada al espacio</h2><button type="button" class="modal-close" data-close-modal aria-label="Cerrar imagen"><svg class="icon" aria-hidden="true"><use href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/iconos.svg#close"/></svg></button></div><img data-modal-photo alt="Foto de referencia ampliada"><p>Fotografía ilustrativa; no es una imagen verificada del inmueble.</p></dialog>
<%@ include file="../layout/pie.jspf" %>
