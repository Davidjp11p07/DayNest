<%@ page pageEncoding="UTF-8" %>
<%@ include file="../layout/cabecera.jspf" %>
<a class="breadcrumb" href="${fn:escapeXml(pageContext.request.contextPath)}/buscar"><c:out value="${textos['ui356']}"/></a>
<div class="detail-heading"><h1><c:out value="${inmueble.titulo}"/></h1><p class="detail-location"><svg class="icon" aria-hidden="true"><use href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/iconos.svg#pin"/></svg><c:out value="${inmueble.ciudad}"/> <c:out value="${textos['ui357']}"/> <c:out value="${inmueble.capacidad}"/> <c:out value="${textos['ui244']}"/></p></div>
<c:choose><c:when test="${not empty fotosInmueble}"><div class="gallery" aria-label="${fn:escapeXml(textos['ui358'])}"><c:forEach var="foto" items="${fotosInmueble}"><button type="button" data-photo aria-label="${fn:escapeXml(textos['enlargePhoto'])} ${fn:escapeXml(textos[foto.tipo])}"><img src="${fn:escapeXml(pageContext.request.contextPath)}/foto?id=${fn:escapeXml(foto.id)}" alt="${fn:escapeXml(empty foto.descripcion ? foto.tipo : foto.descripcion)}" width="800" height="600" loading="lazy"><span class="photo-label"><c:out value="${empty textos[foto.tipo.toString()] ? foto.tipo : textos[foto.tipo.toString()]}"/><c:if test="${fn:startsWith(foto.descripcion, 'Referencia interior ilustrativa')}"> <c:out value="${textos['ui359']}"/></c:if></span></button></c:forEach></div></c:when><c:otherwise><p class="empty"><c:out value="${textos['ui360']}"/></p></c:otherwise></c:choose>
<div class="detail-columns"><div class="detail-content"><section><span class="eyebrow"><c:out value="${textos['ui361']}"/></span><h2><c:out value="${textos['ui362']}"/></h2><p class="description"><c:out value="${inmueble.descripcion}"/></p><p class="capacity"><svg class="icon" aria-hidden="true"><use href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/iconos.svg#users"/></svg><c:out value="${textos['ui363']}"/> <c:out value="${inmueble.capacidad}"/> <c:out value="${textos['ui244']}"/></p></section>
<section><h2><c:out value="${textos['ui364']}"/></h2><p><c:out value="${textos['ui365']}"/> <c:choose><c:when test="${not empty inmueble.areaM2}"><fmt:formatNumber value="${inmueble.areaM2}"/> m²</c:when><c:otherwise><c:out value="${textos['ui110']}"/></c:otherwise></c:choose></p><p><c:out value="${textos['ui366']}"/> <c:choose><c:when test="${not empty inmueble.habitaciones}"><c:out value="${inmueble.habitaciones}"/></c:when><c:otherwise><c:out value="${textos['ui110']}"/></c:otherwise></c:choose></p></section><section><h2><c:out value="${textos['ui367']}"/></h2><p><strong><c:out value="${inmueble.ciudad}"/></strong></p><p><c:out value="${inmueble.direccion}"/></p></section>
<section><h2><c:out value="${textos['ui368']}"/></h2><div class="host-line"><span class="host-icon"><svg class="icon" aria-hidden="true"><use href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/iconos.svg#house"/></svg></span><div><p><strong><c:out value="${inmueble.propietario.nombre}"/></strong></p><p class="muted"><c:out value="${textos['ui369']}"/></p></div></div></section><section><h2><c:out value="${textos['ui370']}"/></h2><c:choose><c:when test="${empty calificaciones}"><p class="muted"><c:out value="${textos['ui371']}"/></p></c:when><c:otherwise><p class="rating-average"><strong><fmt:formatNumber value="${promedioCalificacion}" maxFractionDigits="1"/></strong> / 5 &#183; ${fn:length(calificaciones)} <c:out value="${textos['ui372']}"/></p><div class="reviews"><c:forEach var="cal" items="${calificaciones}"><article class="review"><p class="review-stars" aria-label="${cal.puntuacion} ${fn:escapeXml(textos['outOfFive'])}">${cal.puntuacion} / 5 &#9733;</p><p><c:out value="${cal.comentario}"/></p><small><c:out value="${textos['ui373']}"/> <c:out value="${cal.autor}"/></small></article></c:forEach></div></c:otherwise></c:choose></section></div>
<aside class="panel reservation-card" data-calendar-scope aria-labelledby="titulo-estimacion"><h2 id="titulo-estimacion" class="sr-only"><c:out value="${textos['ui374']}"/></h2><p class="price"><fmt:formatNumber value="${inmueble.precioPorNoche}" pattern="#,##0.00"/> <span class="price-currency"><c:out value="${inmueble.moneda}"/></span></p><p class="muted"><c:out value="${textos['ui245']}"/></p>
<section class="availability"><h3><c:out value="${textos['ui375']}"/></h3><%@ include file="../layout/calendario.jspf" %></section>
<form method="get" action="${fn:escapeXml(pageContext.request.contextPath)}/cliente/reservar"><input type="hidden" name="id" value="${fn:escapeXml(inmueble.id)}"><div data-estimacion data-moneda="${fn:escapeXml(inmueble.moneda)}" data-precio="${fn:escapeXml(inmueble.precioPorNoche)}" class="form-stack"><div class="date-pair"><div class="field"><label for="estimacion-entrada"><c:out value="${textos['ui074']}"/></label><input id="estimacion-entrada" name="entrada" value="${fn:escapeXml(form.entrada)}" min="${fn:escapeXml(minEntrada)}" type="date" data-entrada></div><div class="field"><label for="estimacion-salida"><c:out value="${textos['ui075']}"/></label><input id="estimacion-salida" name="salida" value="${fn:escapeXml(form.salida)}" min="${fn:escapeXml(minEntrada)}" type="date" data-salida></div></div>
<div class="estimate-line"><span data-noches><c:out value="${textos['ui376']}"/></span><span data-subtotal>—</span></div><div class="estimate-line estimate-total" aria-live="polite"><span><c:out value="${textos['ui377']}"/></span><span data-total>—</span></div></div>
<div class="field"><label for="detalle-huespedes"><c:out value="${textos['ui076']}"/></label><input id="detalle-huespedes" name="huespedes" type="number" min="1" max="${fn:escapeXml(inmueble.capacidad)}" value="${fn:escapeXml(form.huespedes)}" placeholder="${fn:escapeXml(textos['ui378'])}"></div><button type="submit"><c:out value="${textos['ui379']}"/></button></form>
<small><c:out value="${textos['ui380']}"/></small><noscript><p class="auth-note"><c:out value="${textos['ui381']}"/></p></noscript></aside></div>
<dialog class="photo-modal" id="galeria-modal" aria-labelledby="titulo-galeria"><div class="modal-head"><h2 id="titulo-galeria"><c:out value="${textos['ui358']}"/></h2><button type="button" class="modal-close" data-close-modal aria-label="${fn:escapeXml(textos['ui382'])}"><svg class="icon" aria-hidden="true"><use href="${fn:escapeXml(pageContext.request.contextPath)}/assets/img/iconos.svg#close"/></svg></button></div><img data-modal-photo alt="${fn:escapeXml(textos['ui383'])}"></dialog>
<%@ include file="../layout/pie.jspf" %>
