<%@ page pageEncoding="UTF-8" %>
<%@ include file="../layout/cabecera.jspf" %>
<section class="panel narrow"><h1><c:choose><c:when test="${empty inmueble}">Publicar inmueble</c:when><c:otherwise>Editar inmueble</c:otherwise></c:choose></h1><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/propietario/${empty inmueble ? 'publicar' : 'editar'}" class="form-stack"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><c:if test="${not empty inmueble}"><input type="hidden" name="id" value="${fn:escapeXml(inmueble.id)}"></c:if><div class="field"><label for="titulo">Título</label><input id="titulo" name="titulo" type="text" value="${fn:escapeXml(empty form ? inmueble.titulo : form.titulo)}" required maxlength="120"></div><div class="field"><label for="ciudad">Ciudad</label><select id="ciudad" name="ciudadId" required><option value="">Seleccione ciudad, región y país</option><c:forEach var="ubicacion" items="${ciudades}"><option value="${fn:escapeXml(ubicacion.id)}" ${(empty form ? inmueble.ubicacion.id : form.ciudadId) == ubicacion.id ? 'selected' : ''}><c:out value="${ubicacion.etiqueta}"/></option></c:forEach></select></div><div class="field"><label for="direccion">Dirección</label><input id="direccion" name="direccion" type="text" value="${fn:escapeXml(empty form ? inmueble.direccion : form.direccion)}" required maxlength="250"></div><div class="field"><label for="descripcion">Descripción</label><textarea id="descripcion" name="descripcion" required maxlength="2000"><c:out value="${empty form ? inmueble.descripcion : form.descripcion}"/></textarea></div><div class="field"><label for="capacidad">Capacidad (huéspedes)</label><input id="capacidad" name="capacidad" type="number" value="${fn:escapeXml(empty form ? inmueble.capacidad : form.capacidad)}" required min="1"></div><div class="field"><label for="precio">Precio por noche (COP en Colombia, EUR en España)</label><input id="precio" name="precio" type="number" value="${fn:escapeXml(empty form ? inmueble.precioPorNoche : form.precio)}" required min="0.01" step="0.01"></div><fieldset><legend>Clasificación del alojamiento</legend><p class="muted">Marca solo características comprobadas. Pendiente significa que aún no se conoce; la ciudad no determina el entorno.</p><div class="field"><label for="tipo">Tipo de inmueble</label><select id="tipo" name="tipo"><option value="">Pendiente de clasificación</option><option value="APARTAMENTO" ${(empty form ? inmueble.tipo : form.tipo) eq 'APARTAMENTO' ? 'selected' : ''}>Apartamento</option><option value="CASA" ${(empty form ? inmueble.tipo : form.tipo) eq 'CASA' ? 'selected' : ''}>Casa</option><option value="CABAÑA" ${(empty form ? inmueble.tipo : form.tipo) eq 'CABAÑA' ? 'selected' : ''}>Cabaña</option><option value="HABITACION" ${(empty form ? inmueble.tipo : form.tipo) eq 'HABITACION' ? 'selected' : ''}>Habitación</option><option value="OTRO" ${(empty form ? inmueble.tipo : form.tipo) eq 'OTRO' ? 'selected' : ''}>Otro</option></select></div><div class="field"><label for="esRural">¿Está en el campo?</label><select id="esRural" name="esRural"><option value="">Pendiente de clasificación</option><option value="true" ${(empty form ? (inmueble.esRural eq null ? '' : (inmueble.esRural ? 'true' : 'false')) : form.esRural) eq 'true' ? 'selected' : ''}>Sí, confirmado</option><option value="false" ${(empty form ? (inmueble.esRural eq null ? '' : (inmueble.esRural ? 'true' : 'false')) : form.esRural) eq 'false' ? 'selected' : ''}>No, confirmado</option></select></div><div class="field"><label for="cercaMar">¿Está cerca del mar?</label><select id="cercaMar" name="cercaMar"><option value="">Pendiente de clasificación</option><option value="true" ${(empty form ? (inmueble.cercaMar eq null ? '' : (inmueble.cercaMar ? 'true' : 'false')) : form.cercaMar) eq 'true' ? 'selected' : ''}>Sí, confirmado</option><option value="false" ${(empty form ? (inmueble.cercaMar eq null ? '' : (inmueble.cercaMar ? 'true' : 'false')) : form.cercaMar) eq 'false' ? 'selected' : ''}>No, confirmado</option></select></div></fieldset><button type="submit">Guardar inmueble</button></form></section>
<%@ include file="../layout/pie.jspf" %>
