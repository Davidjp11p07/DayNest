<%@ page pageEncoding="UTF-8" %>
<%@ include file="../layout/cabecera.jspf" %>
<h1>Bloqueos de disponibilidad</h1><p>Los bloqueos y las reservas ocupan el mismo calendario. El día de salida queda libre.</p>
<form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/propietario/bloquear" class="panel form-stack"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><label for="bloqueo-inmueble">Inmueble</label><select id="bloqueo-inmueble" name="inmuebleId" required><c:forEach var="i" items="${inmuebles}"><option value="${fn:escapeXml(i.id)}"><c:out value="${i.titulo}"/></option></c:forEach></select><label for="bloqueo-inicio">Inicio</label><input id="bloqueo-inicio" name="entrada" type="date" required><label for="bloqueo-fin">Fin (exclusivo)</label><input id="bloqueo-fin" name="salida" type="date" required><label for="bloqueo-motivo">Motivo</label><input id="bloqueo-motivo" name="motivo" maxlength="250" required><button>Crear bloqueo</button></form>
<div class="table-wrap"><table><thead><tr><th>Inicio</th><th>Fin</th><th>Motivo</th><th>Acción</th></tr></thead><tbody><c:forEach var="b" items="${bloqueos}"><tr><td><c:out value="${b.ocupacion.inicio}"/></td><td><c:out value="${b.ocupacion.fin}"/></td><td><c:out value="${b.motivo}"/></td><td><c:choose><c:when test="${b.ocupacion.activa}"><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/propietario/liberar"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(b.ocupacion.id)}"><button>Liberar</button></form></c:when><c:otherwise>Liberado</c:otherwise></c:choose></td></tr></c:forEach></tbody></table></div>
<%@ include file="../layout/pie.jspf" %>