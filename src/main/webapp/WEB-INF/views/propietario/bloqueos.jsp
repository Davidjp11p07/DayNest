<h1><c:out value="${textos['ui299']}"/></h1><p><c:out value="${textos['ui300']}"/></p>
<form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/propietario/bloquear" class="panel form-stack"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><label for="bloqueo-inmueble"><c:out value="${textos['ui026']}"/></label><select id="bloqueo-inmueble" name="inmuebleId" required><c:forEach var="i" items="${inmueblesDisponibles}"><option value="${fn:escapeXml(i.id)}"><c:out value="${i.titulo}"/></option></c:forEach></select><label for="bloqueo-inicio"><c:out value="${textos['ui301']}"/></label><input id="bloqueo-inicio" name="entrada" type="date" required><label for="bloqueo-fin"><c:out value="${textos['ui302']}"/></label><input id="bloqueo-fin" name="salida" type="date" required><label for="bloqueo-motivo"><c:out value="${textos['ui303']}"/></label><input id="bloqueo-motivo" name="motivo" maxlength="250" required><button><c:out value="${textos['ui304']}"/></button></form>
