<%@ page pageEncoding="UTF-8" %>
<%@ include file="../layout/cabecera.jspf" %>
<div class="section-head"><a class="button secondary" href="${fn:escapeXml(pageContext.request.contextPath)}/propietario/bloqueos">Bloquear / liberar fechas</a><h1>Mis inmuebles</h1><a class="button" href="${fn:escapeXml(pageContext.request.contextPath)}/propietario/publicar">Publicar inmueble</a></div><c:if test="${empty inmuebles}"><p class="empty">Todavía no tienes inmuebles. Publica tu primer alojamiento.</p></c:if><div class="grid"><c:forEach var="i" items="${inmuebles}"><article class="card" data-inmueble-id="${fn:escapeXml(i.id)}"><span class="city"><c:out value="${i.ciudad}"/></span><h3><c:out value="${i.titulo}"/></h3><span class="badge"><c:out value="${i.estado}"/></span><p><c:out value="${i.capacidad}"/> huéspedes · <fmt:formatNumber value="${i.precioPorNoche}" pattern="#,##0.00"/> <c:out value="${i.moneda}"/> / noche</p><div class="actions"><a class="button secondary" href="${fn:escapeXml(pageContext.request.contextPath)}/propietario/editar?id=${fn:escapeXml(i.id)}">Editar</a><c:if test="${i.estado eq 'PUBLICADO'}"><form method="post" action="${fn:escapeXml(pageContext.request.contextPath)}/propietario/desactivar"><input type="hidden" name="csrf" value="${fn:escapeXml(sessionScope.csrf)}"><input type="hidden" name="id" value="${fn:escapeXml(i.id)}"><button type="submit" class="danger">Desactivar</button></form></c:if></div></article></c:forEach></div>
<c:set var="paginacion" value="${navInmuebles}"/><%@ include file="../layout/paginador.jspf" %>
<%@ include file="../layout/pie.jspf" %>
